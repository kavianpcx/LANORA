# Public hostname for Caddy TLS and routing
LANORA_PUBLIC_HOST=lan.example.org
# API listen address inside Docker
LANORA_LISTEN_ADDR=:8080
# Persistent SQLite database path (container path)
LANORA_DB_PATH=/data/lanora.db
# Set a long random admin bearer token; leave unset to disable admin summary
LANORA_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
# Exact Origin allowlist for Tauri runtime and local Vite development, comma separated
LANORA_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://localhost:1421,https://kavianpcx.github.io
# Separate secret for the relay node's isolated EasyTier control network
LANORA_RELAY_SECRET=replace-with-64-hex-characters
