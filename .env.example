# Public hostname for Caddy TLS and routing
LANORA_PUBLIC_HOST=lan.example.org
# API listen address inside Docker
LANORA_LISTEN_ADDR=:8080
# Port used by Caddy to reach the API; keep this equal to LANORA_LISTEN_ADDR's port
LANORA_API_INTERNAL_PORT=8080
# Persistent SQLite database path (container path)
LANORA_DB_PATH=/data/lanora.db
# Private token for administrator summary and player-policy management
LANORA_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
# Exact Origin allowlist for Tauri runtime and local Vite development, comma separated
LANORA_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420
# Separate secret for the relay node's isolated EasyTier control network
LANORA_RELAY_SECRET=replace-with-64-hex-characters
# Public relay endpoint reached by Windows clients (distinct from the HTTPS API port)
LANORA_RELAY_PEER_URL=tcp://lan.example.org:11010

# Legacy alpha access code for one-time upgrade migration only. Keep blank on new installs.
LANORA_SHARED_NETWORK_CODE=
