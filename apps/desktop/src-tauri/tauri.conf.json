{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LANORA",
  "version": "0.2.0-alpha.2",
  "identifier": "com.lanora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LANORA",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https://* wss://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Self-hosted virtual LAN gaming",
    "publisher": "LANORA Project",
    "copyright": "Copyright 2026 LANORA contributors",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "uninstallerHeaderImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "LANORA",
        "languages": ["English", "Farsi"],
        "displayLanguageSelector": true
      }
    },
    "resources": [
      "resources/easytier/*",
      "resources/licenses/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libcap2-bin"
        ],
        "postInstallScript": "scripts/deb-postinst"
      }
    }
  }
}
