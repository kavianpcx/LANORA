{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LANORA",
  "version": "0.1.0",
  "identifier": "com.lanora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LANORA",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https://* wss://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Self-hosted virtual LAN gaming",
    "category": "Network",
    "resources": [
      "resources/easytier/*",
      "resources/licenses/*"
    ]
  }
}
